{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pastoral",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  /*
   * PENDIENTE: almacenamiento de archivos (R2).
   *
   * R2 todavía NO está habilitado en la cuenta, por eso las subidas caen en la
   * base de datos (ver src/lib/uploadFile.ts, que solo lo permite para
   * imágenes muy pequeñas).
   *
   * Pasos:
   *   1) Panel de Cloudflare -> R2 -> "Enable R2" (pide método de pago; el
   *      primer gigabyte por mes es gratis).
   *   2) Crear un bucket, por ejemplo "pastoral-uploads".
   *   3) Descomentar el bloque de abajo (el binding se llama UPLOADS_BUCKET y
   *      es el que leen src/app/api/upload y src/app/api/files/[key]).
   */
  // "r2_buckets": [
  //   { "binding": "UPLOADS_BUCKET", "bucket_name": "pastoral-uploads" }
  // ],
  "r2_buckets": [
    { "binding": "UPLOADS_BUCKET", "bucket_name": "pastoral-uploads" }
  ],
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "pastoral-stats",
      "database_id": "31d83fce-dd13-4b81-b85e-ef26ea190a65",
      "migrations_dir": "migrations"
    }
  ],
  /*
   * SERVIR ARCHIVOS: el worker sirve las imágenes desde el binding UPLOADS_BUCKET
   * (getFileStorage usa el binding; no hace falta URL pública ni R2_ACCOUNT_ID).
   *
   * R2_ACCOUNT_ID se dejó apagada a propósito: con ella, /api/files/<clave> responde
   * con un redirect a https://pub-<ACCOUNT_ID>.r2.dev/<bucket> y ese dominio no estaba
   * sirviendo (401 "This bucket... is not publicly accessible"). Mientras el bucket no
   * tenga un dominio público que funcione, es más confiable transmitir desde el binding.
   *
   * Para volver al modo redirect (menos invocaciones) hay dos opciones:
   *   - Conseguir que un dominio público sirva de verdad (R2 → bucket → Settings →
   *     Custom Domains / Public access probado con un archivo real) y definir aquí
   *     R2_ACCOUNT_ID (o R2_PUBLIC_BASE_URL en las vars).
   * R2_PUBLIC_BASE_URL (si se define) tiene prioridad sobre R2_ACCOUNT_ID.
   */
  "vars": {
    "SUPABASE_URL": "https://rtqzphmqnsaxirifdzvu.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_89BBzim5CKpxFWpj2qvuLQ_nVir3Jpv",
    "SITE_URL": "https://pastoral.arzamendiaandres-6d2.workers.dev",
    "R2_BUCKET_NAME": "pastoral-uploads"
  }
}